---
import { copy } from '../content/copy';
import SpreadsheetBackdrop from './SpreadsheetBackdrop.astro';
import StatementCard from './StatementCard.astro';
import WaitlistForm from './WaitlistForm.astro';
---
<section class="hero" aria-labelledby="hero-heading">
  <SpreadsheetBackdrop />
  <div class="wrap">
    <div class="formula" aria-hidden="true"><span class="ref">{copy.formulaRef}</span><span class="fx">{copy.fx}</span><span class="val">{copy.formula}<span class="caret"></span></span></div>
    <div class="hero-grid">
      <div class="hero-copy">
        <h1 id="hero-heading">{copy.headline.start} <span class="l2">{copy.headline.middle}<span class="out">{copy.headline.strike}</span>{copy.headline.end}</span></h1>
        <p class="lede">{copy.subhead}</p>
        <div class="hero-form"><WaitlistForm id="join" /></div>
      </div>
      <div class="hero-card"><StatementCard /></div>
    </div>
  </div>
</section>
<style>
  .hero { position: relative; isolation: isolate; padding: clamp(28px,6vh,72px) 0 clamp(64px,10vh,120px); }
  .formula { display: flex; max-width: 44rem; margin-bottom: clamp(28px,5vh,56px); background: var(--sheet); border: 1px solid var(--cell); border-radius: var(--radius); font: 400 .85rem/1.4 var(--figure); color: var(--graphite); overflow: hidden; }
  .ref { padding: 8px 14px; border-right: 1px solid var(--cell); background: var(--cell-head); color: var(--ink); }
  .fx { padding: 8px 12px; border-right: 1px solid var(--cell); font-style: italic; color: var(--muted); }
  .val { flex: 1; padding: 8px 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .caret { display: inline-block; width: 1px; height: 1em; margin-left: 2px; vertical-align: -2px; background: var(--ink); animation: blink 1.1s steps(1) 6; }
  @keyframes blink { 50% { opacity: 0; } }
  .hero-grid { display: grid; grid-template-columns: minmax(0,1.15fr) minmax(0,1fr); gap: clamp(32px,5vw,80px); align-items: start; }
  h1 { font-size: var(--step-4); line-height: .98; letter-spacing: -.035em; margin-bottom: .45em; }
  @media (min-width: 901px) { h1 { font-size: clamp(3.4rem, 1rem + 4.2vw, 6rem); } .l2 { display: block; white-space: nowrap; } }
  .out { display: inline-block; position: relative; color: var(--graphite); }
  .out::after { content: ''; position: absolute; left: -.04em; right: -.04em; top: 55%; height: .075em; background: var(--ink); transform-origin: left; }
  .lede { font-size: var(--step-1); line-height: 1.45; max-width: var(--measure); margin-bottom: 2rem; text-wrap: pretty; }
  .hero-card { min-width: 0; }
  :global(.intro-play) h1 { animation: fade 400ms var(--ease) 450ms both; }
  :global(.intro-play) .out::after { animation: draw 900ms var(--ease) 800ms both; }
  :global(.intro-play) .lede { animation: settle 400ms var(--ease) 1150ms both; }
  :global(.intro-play) .hero-form, :global(.intro-play) .hero-card { animation: settle 400ms var(--ease) 1300ms both; }
  @keyframes draw { from { transform: scaleX(0); } }
  @keyframes fade { from { opacity: 0; } }
  @keyframes settle { from { opacity: 0; transform: translateY(8px); } }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .formula .fx { display: none; } }
</style>
