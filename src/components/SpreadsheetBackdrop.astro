---
import { copy } from '../content/copy';
const letters = 'ABCDEFGHIJKL'.split('');
const cells = Array.from({ length: 120 }, (_, i) => ({ text: copy.clutter[(i * 7 + Math.floor(i / 12)) % copy.clutter.length], c: i % 12, r: Math.floor(i / 12) }));
---
<div class="spreadsheet" aria-hidden="true">
  <div class="gridlines"></div>
  <div class="columns">{letters.map(letter => <span>{letter}</span>)}</div>
  <div class="numbers">{Array.from({ length: 26 }, (_, i) => <span>{i + 1}</span>)}</div>
  <div class="clutter">{cells.map(({ text, c, r }) => <span class:list={['cell', { highlight: (c + r) % 7 === 0 }]} style={`--c:${c};--r:${r};--delay:${150 + Math.hypot(c - 3, r - 3) * 45}ms`}>{text}</span>)}</div>
</div>
<style>
  .spreadsheet { --cw: calc((100vw - 32px) / 12); --rh: 36px; position: absolute; inset: 0 0 -80px; z-index: -1; pointer-events: none; overflow: hidden; font: 400 .6875rem var(--figure); color: var(--muted); }
  .gridlines { position: absolute; inset: 0; background: linear-gradient(90deg,var(--cell) 1px,transparent 1px) 32px 28px / var(--cw) var(--rh), linear-gradient(var(--cell) 1px,transparent 1px) 32px 28px / var(--cw) var(--rh); opacity: .6; mask-image: linear-gradient(#000,transparent 95%), radial-gradient(ellipse at 35% 50%, transparent 20%, #000 90%); mask-composite: intersect; }
  .columns { display: grid; grid-template-columns: repeat(12,1fr); margin-left: 32px; height: 28px; border-block: 1px solid var(--cell); background: var(--cell-head); opacity: .8; }
  .columns span { text-align: center; border-right: 1px solid var(--cell); line-height: 27px; }
  .numbers { position: absolute; left: 0; top: 28px; width: 32px; border-right: 1px solid var(--cell); opacity: .65; mask-image: linear-gradient(#000,transparent); }
  .numbers span { display: block; text-align: center; height: var(--rh); line-height: var(--rh); border-bottom: 1px solid var(--cell); }
  .clutter { position: absolute; inset: 28px 0 0 32px; opacity: 0; }
  .cell { position: absolute; left: calc(var(--c) * var(--cw)); top: calc(var(--r) * var(--rh)); width: var(--cw); height: var(--rh); line-height: var(--rh); padding: 0 7px; overflow: hidden; white-space: nowrap; }
  .highlight { background: var(--ochre); color: #654900; }
  :global(.intro-play) .clutter { opacity: 1; }
  :global(.intro-play) .cell { animation: clear-cell 350ms var(--ease) var(--delay) both; }
  :global(.intro-play) .gridlines { animation: quiet-grid 900ms var(--ease) both; }
  @keyframes clear-cell { from { opacity: 1; } to { opacity: 0; transform: translateY(-4px); } }
  @keyframes quiet-grid { from { opacity: 1; mask-image: none; } }
  @media (prefers-reduced-motion: reduce) { .clutter { display: none; } }
</style>
