---
import { copy } from '../content/copy';
// Twelve columns by ten rows of first-visit clutter, aligned to the grid cells.
const cells = Array.from({ length: 120 }, (_, i) => ({ text: copy.clutter[(i * 7 + Math.floor(i / 12)) % copy.clutter.length], c: i % 12, r: Math.floor(i / 12) }));
---
<div class="grid" aria-hidden="true" data-grid>
  <div class="clutter">{cells.map(({ text, c, r }) => <span class:list={['cell', { warn: (c + r) % 7 === 0, err: text.startsWith('#') }]} style={`--c:${c};--r:${r};--delay:${150 + Math.hypot(c - 3, r - 3) * 45}ms`}>{text}</span>)}</div>
</div>
<script>
  // The sheet fades as the visitor scrolls away from it.
  const grid = document.querySelector<HTMLElement>('[data-grid]')!;
  const hero = grid.parentElement!;
  const onScroll = () => grid.style.setProperty('--grid-o', (1 - Math.min(1, Math.max(0, scrollY / (hero.offsetHeight * .8)))).toFixed(3));
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
<style>
  .grid { position: absolute; inset: -88px 0 0; z-index: -1; pointer-events: none; overflow: hidden; opacity: var(--grid-o, 1);
    background-image: linear-gradient(to right, var(--cell) 1px, transparent 1px), linear-gradient(to bottom, var(--cell) 1px, transparent 1px);
    background-size: var(--cell-w) var(--cell-h);
    background-position: calc(var(--gutter) - 1px) 0;
    mask-image: linear-gradient(to bottom, #000 0%, #000 55%, transparent 100%);
    transition: opacity .2s linear; }
  .clutter { position: absolute; inset: 0 0 0 var(--gutter); display: none; font: 400 .6875rem var(--figure); color: var(--muted); }
  .cell { position: absolute; left: calc(var(--c) * var(--cell-w)); top: calc(var(--r) * var(--cell-h)); width: var(--cell-w); height: var(--cell-h); line-height: var(--cell-h); padding: 0 7px; overflow: hidden; white-space: nowrap; text-overflow: clip; }
  .warn { background: var(--ochre); color: var(--ochre-ink); }
  .err { color: #a23f4c; }
  :global(.intro-play) .clutter { display: block; }
  :global(.intro-play) .cell { animation: clear-cell 380ms var(--ease) var(--delay) both; }
  @keyframes clear-cell { from { opacity: 1; } to { opacity: 0; transform: translateY(-6px); filter: blur(2px); } }
  @media (max-width: 520px) { .grid { --cell-h: 30px; mask-image: linear-gradient(to bottom, #000 0, #000 280px, transparent 520px); } }
</style>
