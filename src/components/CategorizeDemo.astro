---
import { copy } from '../content/copy';
---
<div class="vis categorize" data-categorize>
  <ul class="rows">{copy.categorize.rows.map(row => <li>
    <span class="merchant">{row.merchant}</span>
    {'uncertain' in row ? <div class="picker"><button type="button" class="cat uncertain" data-category-toggle aria-haspopup="listbox" aria-expanded="false" aria-controls="category-options">{copy.categorize.uncertain}</button><div class="menu" id="category-options" role="listbox" aria-label={copy.categorize.menu} tabindex="-1" hidden>{copy.categorize.categories.map((category, index) => <div role="option" aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-category={category}>{category}</div>)}</div></div> : <span class="cat" data-pigment={row.pigment}>{row.category}</span>}
    <span class="fig amount">{row.amount}</span>
    <span class="check" aria-hidden="true">{copy.check}</span>
  </li>)}</ul>
  <div class="bottom"><p class="remember caption" aria-live="polite">{copy.categorize.unsure}</p><button type="button" class="confirm" data-confirm>{copy.categorize.confirm}</button><p class="confirmed" role="status" hidden></p></div>
</div>
<script>
  import { copy } from '../content/copy';
  const demo = document.querySelector<HTMLElement>('[data-categorize]')!;
  const toggle = demo.querySelector<HTMLButtonElement>('[data-category-toggle]')!;
  const menu = demo.querySelector<HTMLElement>('[role="listbox"]')!;
  const options = [...menu.querySelectorAll<HTMLElement>('[role="option"]')];
  const confirm = demo.querySelector<HTMLButtonElement>('[data-confirm]')!;
  const confirmed = demo.querySelector<HTMLElement>('.confirmed')!;
  function close(restore = false) { menu.hidden = true; toggle.setAttribute('aria-expanded', 'false'); if (restore) toggle.focus(); }
  function open() {
    menu.hidden = false;
    toggle.setAttribute('aria-expanded', 'true');
    (options.find(option => option.getAttribute('aria-selected') === 'true') ?? options[0])!.focus();
  }
  function pick(option: HTMLElement) {
    options.forEach(item => { item.setAttribute('aria-selected', String(item === option)); item.tabIndex = item === option ? 0 : -1; });
    toggle.textContent = option.dataset.category!;
    toggle.classList.remove('uncertain');
    toggle.dataset.pigment = option.dataset.category === 'Restaurants' ? 'ochre' : option.dataset.category === 'Groceries' ? 'sage' : 'violet';
    demo.querySelector<HTMLElement>('.remember')!.textContent = copy.categorize.remember;
    demo.classList.remove('is-confirmed', 'is-picked');
    demo.classList.add('is-picked');
    confirm.textContent = copy.categorize.confirmAll;
    confirm.hidden = false;
    confirmed.hidden = true;
    close(true);
  }
  toggle.addEventListener('click', () => menu.hidden ? open() : close());
  toggle.addEventListener('keydown', event => { if (event.key === 'ArrowDown' || event.key === 'ArrowUp') { event.preventDefault(); open(); } });
  options.forEach(option => option.addEventListener('click', () => pick(option)));
  menu.addEventListener('keydown', event => {
    const index = options.indexOf(document.activeElement as HTMLElement);
    if (event.key === 'Tab') { close(); }
    else if (event.key === 'Escape') { event.preventDefault(); close(true); }
    else if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); if (options[index]) pick(options[index]); }
    else if (['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
      event.preventDefault();
      const next = event.key === 'Home' ? 0 : event.key === 'End' ? options.length - 1 : (index + (event.key === 'ArrowDown' ? 1 : -1) + options.length) % options.length;
      options[next]!.focus();
    }
  });
  document.addEventListener('click', event => { if (!toggle.contains(event.target as Node) && !menu.contains(event.target as Node)) close(); });
  demo.addEventListener('focusout', event => { if (!demo.contains(event.relatedTarget as Node)) close(); });
  confirm.addEventListener('click', () => {
    close();
    demo.classList.add('is-confirmed');
    confirmed.textContent = `${copy.check} ${demo.classList.contains('is-picked') ? copy.categorize.confirmedAll : copy.categorize.confirmed}`;
    confirm.hidden = true;
    confirmed.hidden = false;
    confirmed.tabIndex = -1;
    confirmed.focus();
  });
</script>
<style>
  .rows { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: minmax(0,1fr) auto 6.4em 12px; align-items: center; gap: 10px; min-height: 40px; border-bottom: 1px solid var(--cell); }
  .merchant { font-weight: 500; }
  .amount { font-size: .85rem; text-align: right; }
  .picker { position: relative; justify-self: end; }
  .cat { justify-self: end; }
  button.cat { position: relative; min-height: 28px; border: 1px solid transparent; cursor: pointer; }
  button.cat::after { content: ''; position: absolute; inset: -8px -4px; }
  button.cat.uncertain { border: 1px dashed var(--muted); background: var(--sheet); color: var(--graphite); }
  .menu { position: absolute; right: 0; top: calc(100% + 4px); z-index: 5; min-width: 150px; background: var(--sheet); border: 1px solid var(--line); border-radius: var(--radius); padding: 4px; box-shadow: 0 12px 28px -12px #17191c40; }
  [role='option'] { display: flex; align-items: center; min-height: 40px; padding: 6px 10px; border-radius: 4px; cursor: pointer; }
  [role='option']:hover, [role='option']:focus { background: var(--wash); outline: none; }
  [aria-selected='true'] { font-weight: 600; }
  .check { color: var(--done); opacity: 0; transition: opacity .3s; }
  .is-confirmed li .check { opacity: 1; }
  .is-confirmed:not(.is-picked) li:has(.uncertain) .check { opacity: 0; }
  .bottom { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-top: 6px; }
  .confirm { position: relative; min-height: 36px; border: 1px solid var(--ink); border-radius: 999px; padding: 6px 14px; background: transparent; color: var(--ink); font: 500 .85rem var(--display); transition: background .15s, color .15s; }
  .confirm::after { content: ''; position: absolute; inset: -4px 0; }
  .confirm:hover { background: var(--ink); color: var(--paper); }
  .confirmed { font-size: .85rem; color: var(--done); font-weight: 500; }
</style>
