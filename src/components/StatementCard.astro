---
import { copy } from '../content/copy';
const s = copy.statement;
---
<figure class="statement" aria-label={s.label} data-statement>
  <div class="st-head">
    <div class="files">{s.files.map(file => <span class="file">{file}</span>)}</div>
    <span class="st-status fig" data-status><b>{s.doneLead}</b> · {s.done}</span>
  </div>
  <ul class="tx">
    {s.rows.map(row => <li class={'duplicate' in row ? 'gone' : 'ok'} data-dup={'duplicate' in row ? '' : undefined}>
      <span class="name"><span class="raw" aria-hidden="true">{row.raw}</span><span class="clean">{row.clean}</span></span>
      <span class:list={['amt fig', { fx: 'converted' in row }]}><span class="from">{row.amount}</span>{'converted' in row && <span class="to">{row.converted}</span>}</span>
      <span class="meta">{row.category && <span class="cat" data-pigment={row.pigment}>{row.category}</span>}<span class="why fig">{row.note}</span></span>
    </li>)}
  </ul>
  <div class="st-foot">
    <span class="sum fig" data-sum>{s.summary}</span>
    <button class="link-button" type="button" data-replay>{copy.replay}</button>
  </div>
</figure>
<script>
  import { copy } from '../content/copy';
  const s = copy.statement;
  const card = document.querySelector<HTMLElement>('[data-statement]')!;
  const rows = [...card.querySelectorAll<HTMLLIElement>('.tx li')];
  const status = card.querySelector<HTMLElement>('[data-status]')!;
  const sum = card.querySelector<HTMLElement>('[data-sum]')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  let timers: number[] = [];
  const later = (fn: () => void, ms: number) => timers.push(window.setTimeout(fn, ms));
  function reset() {
    timers.forEach(clearTimeout); timers = [];
    // Jump to the raw state without transitions, then reserve that five-row height so
    // neither the reset nor the duplicate collapsing ever moves the page.
    card.classList.add('instant');
    rows.forEach(row => { row.className = ''; });
    card.parentElement!.style.minHeight = `${card.offsetHeight}px`;
    void card.offsetHeight;
    card.classList.remove('instant');
    status.textContent = s.reading;
    sum.textContent = s.found;
  }
  function finish() {
    timers.forEach(clearTimeout); timers = [];
    rows.forEach(row => { row.className = row.hasAttribute('data-dup') ? 'gone' : 'ok'; });
    status.innerHTML = `<b>${s.doneLead}</b> · ${s.done}`;
    sum.textContent = s.summary;
  }
  function play() {
    if (reduce.matches) { finish(); return; }
    reset();
    let t = 900;
    rows.forEach(row => {
      if (row.hasAttribute('data-dup')) {
        later(() => { row.className = 'dup'; }, t);
        later(() => { row.className = 'gone'; }, t + 900);
        t += 900;
      } else later(() => { row.className = 'ok'; }, t);
      t += 650;
    });
    later(finish, t + 200);
  }
  card.querySelector('[data-replay]')!.addEventListener('click', play);
  reduce.addEventListener('change', () => { if (reduce.matches) finish(); });
  // The finished state is server-rendered. On a first visit the sequence plays once the card is
  // half in view (after the intro has settled), so phone visitors see it too.
  if (document.documentElement.classList.contains('intro-play') && 'IntersectionObserver' in window) {
    reset();
    const notBefore = performance.now() + 1000;
    const observer = new IntersectionObserver(entries => {
      if (!entries[0]!.isIntersecting) return;
      observer.disconnect();
      window.setTimeout(play, Math.max(0, notBefore - performance.now()));
    }, { threshold: .5 });
    observer.observe(card);
  }
</script>
<style>
  .statement { background: var(--sheet); border: 1px solid var(--cell); border-radius: 10px; box-shadow: 0 1px 0 #17191c0a, 0 30px 60px -40px #17191c59; overflow: hidden; }
  .st-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 18px; border-bottom: 1px solid var(--cell); background: var(--cell-head); }
  .files { display: flex; gap: 6px; flex-wrap: wrap; }
  .file { font: 400 .75rem var(--figure); padding: 3px 8px; border-radius: 4px; background: var(--sheet); border: 1px solid var(--cell); color: var(--graphite); }
  .st-status { font-size: .75rem; color: var(--muted); }
  .st-status :global(b) { font-weight: 500; color: var(--done); }
  .tx { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: minmax(0,1fr) auto; gap: 4px 16px; padding: 12px 18px; border-bottom: 1px solid var(--cell); max-height: 120px; overflow: hidden; transition: max-height .6s var(--ease), padding .6s var(--ease), opacity .5s, background .5s; }
  li:last-child { border-bottom: 0; }
  .name { position: relative; min-width: 0; }
  .raw, .clean { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; transition: opacity .45s var(--ease), transform .45s var(--ease); }
  .raw { font: 400 .82rem var(--figure); letter-spacing: .01em; color: var(--graphite); }
  .clean { position: absolute; inset: 0; font: 500 1.02rem var(--display); color: var(--ink); opacity: 0; transform: translateY(6px); }
  .amt { position: relative; min-width: 7.2em; text-align: right; font-size: .95rem; }
  .from, .to { display: block; transition: opacity .45s, transform .45s var(--ease); }
  .to { position: absolute; right: 0; top: 0; opacity: 0; transform: translateY(6px); }
  .meta { grid-column: 1/-1; display: flex; gap: 8px; align-items: center; min-height: 22px; }
  .cat { opacity: 0; transform: scale(.92); transition: opacity .4s, transform .4s var(--ease); }
  .why { font-size: .72rem; color: var(--muted); opacity: 0; transition: opacity .4s .15s; }
  [data-dup] .why { opacity: 1; }
  .instant li, .instant li * { transition: none !important; }
  li.ok .raw { opacity: 0; transform: translateY(-6px); }
  li.ok .clean { opacity: 1; transform: none; }
  li.ok .amt.fx .from { opacity: 0; transform: translateY(-6px); }
  li.ok .amt.fx .to { opacity: 1; transform: none; }
  li.ok .cat, li.ok .why { opacity: 1; transform: none; }
  li.dup { background: var(--dup); }
  li.dup .raw { text-decoration: line-through; text-decoration-color: var(--ink); }
  li.gone { max-height: 0; padding-block: 0; opacity: 0; border-bottom-color: transparent; }
  .st-foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 0 18px; border-top: 1px solid var(--cell); background: var(--cell-head); }
  .sum { font-size: .8rem; color: var(--graphite); }
  @media (max-width: 520px) {
    li { padding: 11px 14px; }
    .st-head, .st-foot { padding-inline: 14px; }
    .st-head { flex-direction: column; align-items: flex-start; gap: 8px; }
  }
</style>
