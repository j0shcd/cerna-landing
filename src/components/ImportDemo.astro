---
import { copy } from '../content/copy';
---
<div class="vis import" aria-hidden="true">
  {copy.import.files.map((file, index) => <div class="file fig" style={`--i:${index}`}><b>{file.name}</b><span>{file.detail}</span></div>)}
  <div class="conversion fig" style="--i:3"><span>{copy.import.conversion}</span><span class="rate">{copy.import.rate}</span></div>
</div>
<style>
  .file { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 8px 10px; border-radius: 5px; background: var(--cell-head); color: var(--graphite); font-size: .8rem; }
  .file b { font-weight: 500; color: var(--ink); }
  .file:nth-child(2) { box-shadow: inset 3px 0 0 var(--ochre-ink); }
  .file:nth-child(3) span { color: var(--muted); }
  .conversion { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 4px 12px; margin-top: 6px; padding: 8px 10px; border: 1px dashed var(--line); border-radius: 5px; font-size: .8rem; color: var(--ink); }
  .rate { color: var(--muted); }
  /* Statements drop in one after another when the section first reveals. */
  :global(.reveal-ready) .import > * { opacity: 0; transform: translateY(-10px); }
  :global(.reveal-ready.in) .import > * { opacity: 1; transform: none; transition: opacity .4s var(--ease), transform .5s var(--ease); transition-delay: calc(250ms + var(--i) * 180ms); }
</style>
