---
import { copy } from '../content/copy';
import WaitlistForm from './WaitlistForm.astro';
---
<section class="close" aria-labelledby="closing-heading" data-reveal>
  <div class="wrap">
    <h2 id="closing-heading">{copy.closing}</h2>
    <WaitlistForm id="join-closing" note={false} />
  </div>
</section>
<style>
  .close { padding: clamp(48px,9vh,112px) 0 clamp(72px,12vh,140px); }
  h2 { font-size: var(--step-4); line-height: .98; letter-spacing: -.035em; max-width: 12ch; margin-bottom: .5em; }
</style>
