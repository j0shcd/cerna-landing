---
import { copy } from '../content/copy';
import ImportDemo from './ImportDemo.astro';
import CategorizeDemo from './CategorizeDemo.astro';
import CheckInDemo from './CheckInDemo.astro';
const demos = [ImportDemo, CategorizeDemo, CheckInDemo];
---
<section class="features" aria-labelledby="features-heading" data-reveal>
  <div class="wrap">
    <h2 id="features-heading">{copy.featuresHeading}</h2>
    <div class="columns">
      {copy.features.map((feature, index) => { const Demo = demos[index]!; return <article class="feature"><h3>{feature.title}</h3><p>{feature.body}</p><Demo /></article>; })}
    </div>
  </div>
</section>
<style>
  .features { position: relative; border-top: 1px solid var(--cell); padding-block: 72px 84px; background: linear-gradient(115deg,#e8ecf5 0%,#eeebf2 48%,#f1e4dd 100%); }
  .features::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 7px; background: linear-gradient(90deg,var(--pigment-sage) 0% 24%,var(--pigment-slate) 24% 45%,var(--pigment-rose) 45% 64%,var(--pigment-ochre) 64% 76%,var(--pigment-violet) 76% 90%,var(--pigment-warm) 90%); }
  h2 { font-size: clamp(2rem,3.4vw,3.1rem); line-height: 1.08; max-width: 25ch; margin-bottom: 48px; }
  .columns { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); }
  .feature { display: grid; grid-template-rows: auto 1fr auto; align-content: start; min-width: 0; padding-inline: 26px; border-left: 1px solid #bfc3cd; }
  .feature:first-child { padding-left: 0; border-left: 0; }
  .feature:last-child { padding-right: 0; }
  h3 { font-size: clamp(1.4rem,1.9vw,1.8rem); line-height: 1.15; margin-bottom: 14px; }
  .feature > p { color: #42474f; font-size: 1.1875rem; line-height: 1.45; padding-bottom: 30px; text-wrap: pretty; }
  .feature :global(.demo) { min-height: 350px; }
  @media (max-width: 1200px) and (min-width: 1024px) { .feature { padding-inline: 16px; } .feature :global(.demo) { padding: 12px; } }
  @media (max-width: 1023px) { .columns { grid-template-columns: 1fr; gap: 44px; } .feature { padding: 28px 0 0; border: 0; border-top: 1px solid #bfc3cd; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 0 32px; } .feature h3 { grid-column: 1; } .feature > p { grid-column: 1; align-self: start; padding-bottom: 0; } .feature :global(.demo) { grid-column: 2; grid-row: 1/4; min-height: 320px; } }
  @media (max-width: 640px) { .features { padding-block: 56px; } h2 { margin-bottom: 32px; } .feature { display: flex; flex-direction: column; } .feature > p { padding-bottom: 24px; } .feature :global(.demo) { min-height: 320px; } }
</style>
