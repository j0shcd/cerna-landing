{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cerna-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "WAITLIST_DB",
      "database_name": "cerna-waitlist",
      // Replace after `npx wrangler d1 create cerna-waitlist --jurisdiction=eu`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "SITE_ORIGIN": "https://cerna.example",
    "MAIL_FROM": "waitlist@cerna.example",
    "MAIL_FROM_NAME": "Cerna",
    "ADMIN_NOTIFY_TO": "owner@cerna.example",
    "CONSENT_VERSION": "2026-10-20",
    "EMAIL_ENABLED": "false"
  }
}
