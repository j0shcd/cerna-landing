---
import { copy } from '../content/copy';
interface Props { id: string; note?: boolean }
// The note appears once, under the first form; the closing form stays bare.
const { id, note = true } = Astro.props;
const describedBy = note ? `${id}-note ${id}-status` : `${id}-status`;
---
<div class="waitlist" id={id} data-waitlist>
  <form method="post" action="/api/waitlist" id={`${id}-form`}>
    <label class="sr-only" for={`${id}-email`}>{copy.form.label}</label>
    <div class="row">
      <span class="fx fig" aria-hidden="true">{copy.fx}</span>
      <input id={`${id}-email`} name="email" type="email" autocomplete="email" placeholder={copy.form.placeholder} aria-describedby={describedBy} required />
      <button class="btn" type="submit">{copy.form.button}</button>
    </div>
    <div class="honeypot" aria-hidden="true">
      <label for={`${id}-company`}>{copy.form.company}</label>
      <input id={`${id}-company`} name="company" type="text" tabindex="-1" aria-hidden="true" autocomplete="off" />
    </div>
  </form>
  {note && <p class="note" id={`${id}-note`}>{copy.form.note}</p>}
  <p class="form-status" id={`${id}-status`} aria-live="polite" aria-atomic="true" tabindex="-1"></p>
</div>
<script>
  import '../scripts/waitlist';
</script>
<style>
  @property --beam { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
  .waitlist { --beam-tip: color-mix(in oklab, var(--cobalt) 35%, var(--sheet)); max-width: 30rem; scroll-margin-top: 30px; }
  .row { display: flex; align-items: stretch; gap: 8px; background: var(--sheet); border: 1px solid var(--line); border-radius: calc(var(--radius) + 4px); padding: 6px; box-shadow: var(--shadow-field); transition: border-color .15s; }
  .row:focus-within { border-color: var(--cobalt); }
  /* Called from the header link: one beam of light runs around the field, a ring ripples out, then it rests in focus. */
  .row { position: relative; }
  .row::before, .row::after { content: ''; position: absolute; pointer-events: none; border-radius: inherit; opacity: 0; }
  .row::before { inset: -2px; padding: 2px; background: conic-gradient(from var(--beam), transparent 0 58%, var(--beam-tip) 76%, var(--cobalt) 93%, transparent 100%);
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); mask-composite: exclude; -webkit-mask-composite: xor; }
  .row::after { inset: -1px; box-shadow: 0 0 0 0 var(--cobalt); }
  :global(.is-called) .row { animation: hold-border 1.1s linear both; }
  :global(.is-called) .row::before { animation: beam 1.1s cubic-bezier(.4,0,.2,1) both; }
  :global(.is-called) .row::after { animation: ripple 1s var(--ease) .75s both; }
  @keyframes hold-border { 0%, 82% { border-color: var(--line); } 100% { border-color: var(--cobalt); } }
  @keyframes beam { 0% { --beam: 0deg; opacity: 0; } 12% { opacity: 1; } 80% { opacity: 1; } 100% { --beam: 360deg; opacity: 0; } }
  @keyframes ripple { 0% { opacity: .35; box-shadow: 0 0 0 0 var(--cobalt); } 100% { opacity: 0; box-shadow: 0 0 0 12px var(--cobalt); } }
  .fx { display: flex; align-items: center; padding: 0 4px 0 10px; color: var(--muted); font-size: .85rem; font-style: italic; }
  input { flex: 1; min-width: 0; border: 0; background: transparent; padding: 10px 8px; color: var(--ink); font: 500 1rem var(--display); outline: none; }
  input::placeholder { color: var(--muted); }
  .note { margin-top: .7rem; font: 400 var(--step--1)/1.5 var(--figure); color: var(--muted); }
  .form-status { overflow-wrap: anywhere; font: 400 .95rem/1.5 var(--display); color: var(--error); }
  .form-status:not(:empty) { margin-top: .6rem; }
  .is-done form, .is-done .note { display: none; }
  .is-done .form-status { margin: 0; color: var(--ink); background: var(--sheet); border: 1px solid var(--cell); border-left: 3px solid var(--done); border-radius: calc(var(--radius) + 4px); padding: 16px 18px; animation: rise .5s var(--ease); }
  @keyframes rise { from { opacity: 0; transform: translateY(6px); } }
  .honeypot { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  @media (max-width: 520px) {
    .row { flex-wrap: wrap; padding: 8px; }
    input { width: calc(100% - 40px); }
    .btn { width: 100%; padding: 14px; }
  }
</style>
