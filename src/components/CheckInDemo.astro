---
import { copy } from '../content/copy';
const c = copy.checkIn;
---
<div class="vis brief" role="img" aria-label={`${c.label}: ${c.heading} ${c.total}, ${c.status.toLowerCase()}. ${c.first} ${c.detail} ${c.second} ${c.secondAmount} ${c.secondDetail}`}>
  <div class="month"><span class="caption">{c.heading}</span><span class="usual">{c.status}</span></div>
  <p class="total fig">{c.total}</p>
  <div class="range"><span class="band"></span><span class="dot"></span></div>
  <ul>
    <li><span class="k"></span><span><b>{c.first}</b> {c.detail}</span></li>
    <li><span class="k fx"></span><span>{c.second} <span class="fig">{c.secondAmount}</span> {c.secondDetail}</span></li>
  </ul>
</div>
<style>
  /* D3's monthly brief, set in D5's beat card. */
  .month { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .usual { font-size: .85rem; font-weight: 500; color: var(--done); }
  .total { font-size: 1.9rem; line-height: 1.1; letter-spacing: -.03em; }
  .range { position: relative; height: 6px; margin: 8px 0 6px; border-radius: 99px; background: var(--cell-head); }
  .band { position: absolute; inset: 0 32% 0 30%; border-radius: 99px; background: var(--sage); }
  .dot { position: absolute; left: 52%; top: 50%; width: 12px; height: 12px; margin: -9px 0 0 -9px; border-radius: 50%; background: var(--done); border: 3px solid var(--sheet); box-sizing: content-box; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { display: flex; gap: 10px; padding: 8px 0; border-top: 1px solid var(--cell); font-size: .85rem; line-height: 1.35; color: var(--graphite); }
  li b { font-weight: 500; color: var(--ink); }
  .k { flex: none; width: 8px; height: 8px; margin-top: 5px; border-radius: 50%; background: var(--rose-ink); }
  .k.fx { background: var(--line); }
</style>
