---
import { copy } from '../content/copy';
const c = copy.categorize;
const decided = c.rows.filter(row => !('uncertain' in row)).length;
---
<!-- A small copy of the app's Review queue (cerna-app ReviewCard): merchant and amount, date and account,
     the suggested category with its pigment dot, and one Approve. Only the unsure row is interactive. -->
<div class="vis review" data-categorize role="group" aria-label={c.label}>
  <div class="head">
    <span class="title">{c.title}</span>
    <span class="needs" data-needs><span class="dot attention" aria-hidden="true"></span><span data-needs-text>{c.needs}</span></span>
    <button type="button" class="approve" data-confirm data-count={decided}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" /></svg><span data-confirm-text>{c.approve(decided)}</span></button>
  </div>
  <ul class="items">{c.rows.map(row => <li class:list={['item', { unsure: 'uncertain' in row }]}>
    <span class="merchant">{row.merchant}</span>
    <span class="amount fig">{row.amount}</span>
    {'uncertain' in row
      ? <span class="meta worth" data-meta data-date={row.meta}><span class="dot attention" aria-hidden="true"></span>{c.worth}</span>
      : <span class="meta">{row.meta}</span>}
    {'uncertain' in row
      ? <div class="picker">
          <button type="button" class="field" data-category-toggle aria-haspopup="listbox" aria-expanded="false" aria-controls="category-options"><span class="dot" style={`background: var(--dot-${row.dot})`} aria-hidden="true"></span><span data-field-text>{row.category}</span><svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" /></svg></button>
          <div class="menu" id="category-options" role="listbox" aria-label={c.menu} tabindex="-1" hidden>{c.categories.map((category, index) => <div role="option" aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-category={category.name} data-dot={category.dot}><span class="dot" style={`background: var(--dot-${category.dot})`} aria-hidden="true"></span>{category.name}</div>)}</div>
        </div>
      : <span class="field static"><span class="dot" style={`background: var(--dot-${row.dot})`} aria-hidden="true"></span>{row.category}</span>}
    <span class="check" aria-hidden="true">{copy.check}</span>
  </li>)}</ul>
  <p class="status" role="status" aria-live="polite" data-status-line></p>
</div>
<script>
  import { copy } from '../content/copy';
  const c = copy.categorize;
  const demo = document.querySelector<HTMLElement>('[data-categorize]')!;
  const toggle = demo.querySelector<HTMLButtonElement>('[data-category-toggle]')!;
  const menu = demo.querySelector<HTMLElement>('[role="listbox"]')!;
  const options = [...menu.querySelectorAll<HTMLElement>('[role="option"]')];
  const confirm = demo.querySelector<HTMLButtonElement>('[data-confirm]')!;
  const confirmText = demo.querySelector<HTMLElement>('[data-confirm-text]')!;
  const status = demo.querySelector<HTMLElement>('[data-status-line]')!;
  const unsureRow = toggle.closest<HTMLElement>('.item')!;
  const meta = unsureRow.querySelector<HTMLElement>('[data-meta]')!;
  const total = c.rows.length;
  let picked = false;
  function close(restore = false) { menu.hidden = true; toggle.setAttribute('aria-expanded', 'false'); if (restore) toggle.focus(); }
  function open() {
    menu.hidden = false;
    toggle.setAttribute('aria-expanded', 'true');
    (options.find(option => option.getAttribute('aria-selected') === 'true') ?? options[0])!.focus();
  }
  function pick(option: HTMLElement) {
    options.forEach(item => { item.setAttribute('aria-selected', String(item === option)); item.tabIndex = item === option ? 0 : -1; });
    demo.querySelector<HTMLElement>('[data-field-text]')!.textContent = option.dataset.category!;
    toggle.querySelector<HTMLElement>('.dot')!.style.background = `var(--dot-${option.dataset.dot})`;
    picked = true;
    unsureRow.classList.remove('unsure');
    unsureRow.classList.add('just-picked');
    meta.textContent = meta.dataset.date!;
    meta.classList.remove('worth');
    demo.querySelector<HTMLElement>('[data-needs-text]')!.textContent = c.clear;
    demo.querySelector<HTMLElement>('[data-needs] .dot')!.className = 'dot clear';
    demo.classList.remove('is-approved');
    confirm.hidden = false;
    confirmText.textContent = c.approve(total);
    status.textContent = c.remember;
    close(true);
  }
  toggle.addEventListener('click', () => menu.hidden ? open() : close());
  toggle.addEventListener('keydown', event => { if (event.key === 'ArrowDown' || event.key === 'ArrowUp') { event.preventDefault(); open(); } });
  options.forEach(option => option.addEventListener('click', () => pick(option)));
  menu.addEventListener('keydown', event => {
    const index = options.indexOf(document.activeElement as HTMLElement);
    if (event.key === 'Tab') { close(); }
    else if (event.key === 'Escape') { event.preventDefault(); close(true); }
    else if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); if (options[index]) pick(options[index]); }
    else if (['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
      event.preventDefault();
      const next = event.key === 'Home' ? 0 : event.key === 'End' ? options.length - 1 : (index + (event.key === 'ArrowDown' ? 1 : -1) + options.length) % options.length;
      options[next]!.focus();
    }
  });
  document.addEventListener('click', event => { if (!toggle.contains(event.target as Node) && !menu.contains(event.target as Node)) close(); });
  demo.addEventListener('focusout', event => { if (!demo.contains(event.relatedTarget as Node)) close(); });
  confirm.addEventListener('click', () => {
    close();
    const count = picked ? total : Number(confirm.dataset.count);
    demo.classList.add('is-approved');
    status.textContent = `${copy.check} ${c.approved(count)}${picked ? '' : ` · ${c.waits}`}`;
    confirm.hidden = true;
    status.tabIndex = -1;
    status.focus();
  });
</script>
<style>
  .review { container-type: inline-size; justify-content: flex-start; gap: 0; padding: 14px 16px 12px; }
  .head { display: flex; align-items: center; gap: 10px; min-height: 36px; padding-bottom: 10px; border-bottom: 1px solid var(--cell); }
  .title { font-weight: 600; font-size: 1rem; letter-spacing: -.01em; }
  .needs { display: inline-flex; align-items: center; gap: 6px; margin-right: auto; font-size: .8rem; color: var(--muted); }
  .dot { flex: none; width: 7px; height: 7px; border-radius: 50%; }
  .dot.attention { background: var(--attention); }
  .dot.clear { background: var(--done); }
  .approve { position: relative; display: inline-flex; align-items: center; gap: 5px; min-height: 32px; padding: 4px 11px; border: 1px solid var(--cobalt); border-radius: var(--radius); background: transparent; color: var(--cobalt); font: 500 .82rem var(--display); transition: background .15s, color .15s; }
  .approve::after { content: ''; position: absolute; inset: -6px 0; }
  .approve:hover { background: var(--cobalt); color: var(--on-cobalt); }
  .approve svg, .chev { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .items { list-style: none; margin: 0; padding: 0; }
  .item { position: relative; display: grid; grid-template-columns: minmax(0,1fr) auto; align-items: center; gap: 3px 12px; padding: 10px 22px 10px 0; border-bottom: 1px solid var(--cell); transition: background .4s; }
  .item:last-child { border-bottom: 0; }
  .merchant { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; font-size: .95rem; }
  .amount { font-size: .92rem; text-align: right; }
  .meta { display: inline-flex; align-items: center; gap: 6px; min-width: 0; font-size: .78rem; color: var(--muted); white-space: nowrap; }
  .meta.worth { color: var(--attention); font-weight: 500; }
  .field { display: inline-flex; align-items: center; gap: 6px; justify-self: end; font-size: .82rem; white-space: nowrap; }
  .field.static { padding: 3px 0; color: var(--graphite); }
  .picker { position: relative; justify-self: end; }
  button.field { position: relative; min-height: 28px; padding: 3px 6px 3px 9px; border: 1px solid var(--attention-line); border-radius: var(--radius); background: var(--sheet); color: var(--ink); font: 500 .82rem var(--display); cursor: pointer; transition: border-color .15s; }
  button.field::after { content: ''; position: absolute; inset: -8px -4px; }
  button.field:hover { border-color: var(--attention); }
  .item:not(.unsure) button.field { border-color: var(--line); }
  .item:not(.unsure) button.field:hover { border-color: var(--graphite); }
  .chev { color: var(--muted); }
  .menu { position: absolute; right: 0; top: calc(100% + 4px); z-index: 5; min-width: 160px; padding: 4px; background: var(--sheet); border: 1px solid var(--line); border-radius: 8px; box-shadow: var(--shadow-pop); }
  [role='option'] { display: flex; align-items: center; gap: 8px; min-height: 40px; padding: 6px 10px; border-radius: 4px; font-size: .88rem; cursor: pointer; }
  [role='option']:hover, [role='option']:focus { background: var(--wash); outline: none; }
  [aria-selected='true'] { font-weight: 600; }
  .check { position: absolute; right: 0; top: 50%; translate: 0 -50%; color: var(--done); font-weight: 600; opacity: 0; transition: opacity .3s; }
  .is-approved .item:not(.unsure) .check { opacity: 1; }
  .just-picked { animation: picked 1.2s var(--ease); }
  @keyframes picked { 0%, 30% { background: var(--wash); } }
  .status { min-height: 1.4em; padding-top: 8px; font-size: .8rem; color: var(--graphite); }
  .is-approved .status { color: var(--done); font-weight: 500; }
  @container (max-width: 300px) {
    .item { grid-template-columns: minmax(0,1fr) auto; }
    .meta { grid-column: 1 / -1; }
    .field, .picker { grid-column: 1 / -1; justify-self: start; }
    .menu { right: auto; left: 0; }
  }
</style>
